# 优化版 .dockerignore - 减少构建上下文大小

# Git 相关
.git
.gitignore
.github

# Node.js
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Next.js
.next
out

# 环境变量
.env*
*.env

# IDE
.vscode
.idea
*.iml

# 操作系统
.DS_Store
Thumbs.db

# 文档和说明
README.md
CHANGELOG.md
LICENSE
*.md

# 测试
__tests__
*.test.js
*.test.ts
*.spec.js
*.spec.ts
coverage

# 其他构建工具
.eslintrc*
.prettierrc*
tsconfig.json
tailwind.config.ts
postcss.config.mjs

# Firebase
apphosting.yaml

# Docker 相关
Dockerfile*
docker-compose*
.dockerignore*

# 临时文件
*.tmp
*.temp
.cache